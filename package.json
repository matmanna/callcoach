{
  "name": "stewardship-copilot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "concurrently -n web,api,crm -c cyan,green,magenta \"pnpm --filter @sc/web dev\" \"pnpm --filter @sc/api dev\" \"pnpm --filter @sc/crm-stub dev\"",
    "test": "vitest run",
    "typecheck": "pnpm -r --parallel typecheck",
    "db:generate": "pnpm --filter @sc/api db:generate",
    "db:migrate": "pnpm --filter @sc/api db:migrate",
    "db:seed": "pnpm --filter @sc/api db:seed"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
