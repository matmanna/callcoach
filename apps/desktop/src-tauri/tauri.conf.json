{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Stewardship Copilot",
  "version": "0.1.0",
  "identifier": "dev.stewardship.copilot.prototype",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "LAB_ENABLED=1 pnpm --filter @sc/web dev",
    "beforeBuildCommand": "LAB_ENABLED=1 pnpm --filter @sc/web build"
  },
  "app": {
    "windows": [
      {
        "title": "Stewardship Copilot (prototype)",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:8787 http://127.0.0.1:11434",
        "script-src": "'self' 'wasm-unsafe-eval' blob:",
        "worker-src": "'self' blob:",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'"
      },
      "devCsp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:8787 http://127.0.0.1:11434 ws://localhost:5173",
        "script-src": "'self' 'wasm-unsafe-eval' blob:",
        "worker-src": "'self' blob:",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
