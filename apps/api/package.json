{
  "name": "@sc/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "db:init": "tsx --env-file-if-exists=../../.env src/db/initCli.ts",
    "db:seed:demo": "tsx --env-file-if-exists=../../.env src/db/seedDemo.ts",
    "db:org-code": "tsx --env-file-if-exists=../../.env src/db/orgCode.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1149.0",
    "@hono/node-server": "^2.1.4",
    "@sc/rules": "workspace:*",
    "@sc/shared": "workspace:*",
    "better-auth": "^1.7.7",
    "hono": "^4.13.13",
    "mongodb": "^7.7.0",
    "papaparse": "^5.7.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2"
  }
}
