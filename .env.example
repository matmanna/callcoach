# Database (local Docker replica set; Atlas URI in other environments)
MONGODB_URI=mongodb://localhost:27017/stewardship?replicaSet=rs0&directConnection=true

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin the browser uses for /api/auth (Vite proxies /api to the API in dev)
BETTER_AUTH_URL=http://localhost:5173
APP_ORIGIN=http://localhost:5173

# Dev seed coordinator (synthetic). db:seed creates this account if missing.
SEED_COORDINATOR_EMAIL=coordinator@example.org
SEED_COORDINATOR_PASSWORD=dev-only-password-123

AWS_REGION=us-east-1
AWS_PROFILE=stewardship-dev
# us-east-2 on the free plan: Llama 3.3 70B works today. Claude needs the Anthropic use-case form in the Bedrock console first.
BEDROCK_MODEL_ID=us.meta.llama3-3-70b-instruct-v1:0
FACT_STALE_DAYS=365
CRM_STUB_URL=http://localhost:8788
